{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/codex-plugin/taste/hooks/steer.ts\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/codex-plugin/taste/hooks/steer.ts\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/codex-plugin/taste/hooks/steer.ts\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(?:apply_patch|Write|Edit|MultiEdit|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/codex-plugin/hooks/godot3-guard.ts\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(?:apply_patch|Write|Edit|MultiEdit|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/codex-plugin/hooks/godot3-guard.ts\""
          }
        ]
      },
      {
        "matcher": "^(?:wait_agent|multi_agent_v1\\.wait_agent|multi_agent_v1wait_agent|collaboration\\.wait_agent|collaborationwait_agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/codex-plugin/taste/hooks/steer.ts\""
          }
        ]
      }
    ]
  }
}
