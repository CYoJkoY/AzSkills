{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "statusMessage": "Re-grounding an active delivery-loop goal",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/codex-plugin/hooks/delivery-session.ts"
            ]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "statusMessage": "Recording the delivery-loop prompt for a restart",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/codex-plugin/hooks/delivery-prompt.ts"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "statusMessage": "Checking visible messages for leaked reasoning tags",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/no-think-tags/hooks/tool-hook.ts"
            ]
          }
        ]
      },
      {
        "matcher": "^(?:Bash|Shell|LocalShell|exec_command|run_command|run_shell|Terminal|PowerShell|pwsh|Task|Agent|spawn_agent|spawn_subagent|subagent|delegate|dispatch_agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "statusMessage": "Checking delivery-loop guard",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/codex-plugin/hooks/delivery-guard.ts"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "statusMessage": "Checking the reply for a dead loop",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/codex-plugin/hooks/delivery-stop.ts"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "statusMessage": "Correcting a leaked reasoning block",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/no-think-tags/hooks/stop-hook.ts"
            ]
          }
        ]
      }
    ]
  }
}
