{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/codex-plugin/taste/hooks/steer.ts\"",
            "statusMessage": "Loading GPT with Taste main guidance"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/codex-plugin/taste/hooks/steer.ts\"",
            "statusMessage": "Applying GPT with Taste request guidance"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/codex-plugin/taste/hooks/steer.ts\"",
            "statusMessage": "Applying GPT with Taste subagent guidance"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(?:apply_patch|Write|Edit|MultiEdit|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/codex-plugin/hooks/godot3-guard.ts\"",
            "statusMessage": "Checking Godot 3.x edits"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(?:apply_patch|Write|Edit|MultiEdit|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/codex-plugin/hooks/godot3-guard.ts\"",
            "statusMessage": "Verifying Godot 3.x edits"
          }
        ]
      },
      {
        "matcher": "^(?:wait_agent|multi_agent_v1\\.wait_agent|multi_agent_v1wait_agent|collaboration\\.wait_agent|collaborationwait_agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/codex-plugin/taste/hooks/steer.ts\"",
            "statusMessage": "Applying GPT with Taste agent results guidance"
          }
        ]
      }
    ]
  }
}
