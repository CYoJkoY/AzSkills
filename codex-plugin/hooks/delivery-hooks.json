{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/codex-plugin/hooks/delivery-session.ts\"",
            "statusMessage": "Re-grounding an active delivery-loop goal"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/codex-plugin/hooks/delivery-prompt.ts\"",
            "statusMessage": "Recording the delivery-loop prompt for a restart"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(?:Bash|Shell|LocalShell|exec_command|run_command|run_shell|Terminal|PowerShell|pwsh|Task|Agent|spawn_agent|spawn_subagent|subagent|delegate|dispatch_agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/codex-plugin/hooks/delivery-guard.ts\"",
            "statusMessage": "Checking delivery-loop guard"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/codex-plugin/hooks/delivery-stop.ts\"",
            "statusMessage": "Checking the reply for a dead loop"
          }
        ]
      }
    ]
  }
}
